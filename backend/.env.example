# Database
DATABASE_URL=postgresql://user:password@localhost:5432/webclass

# Auth (required)
JWT_SECRET=replace-with-at-least-32-random-characters

# Frontend origin for CORS and OAuth redirects
FRONTEND_URL=http://localhost:5173

# Google OAuth (optional until Google sign-in is enabled)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3001/api/oauth/google/callback

# Set to production in deployed environments
NODE_ENV=development
