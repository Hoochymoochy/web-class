# PostgreSQL (see backend/prisma/Readme for local DB setup)
DATABASE_URL=postgresql://postgres:password@localhost:5432/webclass

# JWT signing secret for local and Google auth sessions
JWT_SECRET=change-me-to-a-long-random-string

# Public URLs — used for OAuth redirects and post-login navigation
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173

# Google OAuth 2.0 (Web application client from Google Cloud Console)
# Consent screen + credentials: docs/identity/google-oauth-setup.md
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must match an Authorized redirect URI in Google Cloud Console.
# Default when unset: {BACKEND_URL}/api/oauth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3001/api/oauth/google/callback
